{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "node-terminal",
            "name": "Run Script: Build and Launch",
            "request": "launch",
            "command": "npm run build && npx vite --port=4000 && nodemon --inspect /server/connection.ts ",
            "cwd": "${workspaceFolder}/Future-Student",
            "sourceMaps": true,
            "skipFiles": ["<node_internals>/**"],
            "outFiles": ["${workspaceFolder}/dist/**/*.js"]
        },  
        {
            "type": "node",
            "request": "launch",
            "name": "Backend Debug",
            "program": "${workspaceFolder}/Future-Student/server/connection.ts",
            "console": "integratedTerminal",
            "sourceMaps": true,
            "restart": true,
            "skipFiles": ["<node_internals>/**"],
            "outFiles": ["${workspaceFolder}/dist/**/*.js"]
        },
        {
            "type": "firefox",
            "request": "launch",
            "name": "Frontend Debug (Firefox)",
            "url": "http://localhost:4000",
            "webRoot": "${workspaceFolder}/Future-Student/client/"
        }
    ],
    "compounds": [
        {
            "name": "Full Stack Debug",
            "configurations": [
                "Backend Debug",
                "Run Script: Build and Launch",
                "Frontend Debug (Firefox)"
            ]
        }
    ]
}