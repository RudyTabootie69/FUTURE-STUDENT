{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "node-terminal",
            "name": "Run Script: Build and Launch",
            "request": "launch",
            "command": "npm run build && npx vite --port=4000",
            "cwd": "${workspaceFolder}/Future-Student",
            "sourceMaps": true,
            "skipFiles": ["<node_internals>/**"]
        },  
        {
            "type": "node-terminal",
            "name": "Run Script: Launch and Debug",
            "request": "launch",
            "command": "npm run dev ",
            "cwd": "${workspaceFolder}/Future-Student",
            "sourceMaps": true,
            "skipFiles": ["<node_internals>/**"]
        },  
       {
            "type": "node",
            "request": "launch",
            "name": "Debug Server (tsx)",
            "runtimeArgs": ["-r", "tsx"],
            "args": ["server/index.ts"],
            "cwd": "${workspaceFolder}/Future-Student",
            "sourceMaps": true,
            "skipFiles": ["<node_internals>/**"],
            "console": "integratedTerminal",
            "env": {
                "NODE_ENV": "development"
            }
        },
        {
            "type": "firefox",
            "request": "launch",
            "name": "Frontend Debug (Firefox)",
            "url": "http://localhost:4000",
            "webRoot": "${workspaceFolder}/Future-Student/client/"
        }
    ],
    "compounds": [
        {
            "name": "Full Stack Debug",
            "configurations": [
                //"Backend Debug",
                "Run Script: Launch and Debug",
                "Frontend Debug (Firefox)"
            ]
        }
    ]
}